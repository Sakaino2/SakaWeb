---
import Container from "../general/Container.astro";
import SectionTitle from "../general/SectionTitle.astro";
import { Button } from "../ui/button";
import { t } from "@/i18n";
import type { Locale } from "@/i18n";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const cvFiles: Record<Locale, string | null> = {
  es: "/about/Jorge-Sakaino-Dev-CV-ES.pdf",
  en: "/about/Jorge-Sakaino-Dev-CV-EN.pdf",
};
const cvHref = cvFiles[lang];
---

<Container className="py-8 md:py-16">
  <div
    class="flex flex-col md:flex-row items-center md:items-start gap-8 w-full mx-auto"
  >
    <div class="shrink-0">
      <img
        src="/about/cv-photo.webp"
        alt={t(lang, "about.alt")}
        class="w-48 h-48 md:w-64 md:h-64 rounded-2xl object-cover shadow-lg"
      />
    </div>

    <div class="text-justify">
      <div class="flex justify-between">
        <SectionTitle>{t(lang, "about.title")}</SectionTitle>
        {
          cvHref && (
            <a href={cvHref} download>
              <Button className="cursor-pointer" client:load>
                {t(lang, "about.downloadCv")}
              </Button>
            </a>
          )
        }
      </div>
      <p class="mt-4 text-xl text-gray-500 dark:text-gray-400">
        {t(lang, "about.bio")}
      </p>
    </div>
  </div>
</Container>
