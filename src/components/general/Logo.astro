---
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  src: string;
  class?: string;
}

const { src, class: className } = Astro.props;

const filePath = join(process.cwd(), "public", src);
const raw = readFileSync(filePath, "utf-8");

const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 100 100";

const inner = raw
  .replace(/<\?xml[^?]*\?>/g, "")
  .replace(/^<svg[^>]*>/i, "")
  .replace(/<\/svg>\s*$/i, "");
---

<svg
  viewBox={viewBox}
  class={className}
  set:html={inner}
  aria-hidden="true"
/>
