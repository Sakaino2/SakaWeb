---
import { Navbar } from "./Navbar";
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { Locale } from "@/i18n";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<header
  class="w-full inline-flex items-center justify-between bg-background px-6 md:px-8"
>
  <a href={`/${lang}`} class="text-[#192e5f] dark:text-white">
    <span class="sr-only">Sakaweb</span>
    <Logo
      src="/logos/logo-horizontal.svg"
      class="hidden md:block h-8"
    />
    <Logo
      src="/logos/logo-icon.svg"
      class="block md:hidden h-8 m-2"
    />
  </a>
  <div class="flex items-center gap-2">
    <Navbar lang={lang} client:only="react" />
    <LanguageSwitcher lang={lang} pathname={Astro.url.pathname} />
  </div>
</header>
