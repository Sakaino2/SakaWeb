---
import { FooterNavbar } from "./FooterNavbar";
import Logo from "./Logo.astro";
import { t } from "@/i18n";
import type { Locale } from "@/i18n";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<footer
  class="p-4 bg-background md:p-8 lg:p-10 dark:bg-gray-800"
>
  <div class="mx-auto max-w-7xl text-center">
    <a
      href={`/${lang}`}
      class="flex justify-center items-center text-2xl font-semibold text-[#192e5f] dark:text-white pb-4"
      ><span class="sr-only">Sakaweb</span
      ><Logo
        src="/logos/logo-horizontal.svg"
        class="h-10 me-3 pl-4"
      /></a
    >
    <div class="flex flex-wrap justify-center items-center mb-6">
      <FooterNavbar lang={lang} />
    </div>
    <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400"
      >© 2026 <a href={`/${lang}`} class="hover:underline">{t(lang, "copyright.name")}</a>. {t(lang, "footer.rights")}</span
    >
  </div>
</footer>
