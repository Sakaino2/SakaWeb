---
import Layout from "../../layouts/Layout.astro";
import Hero from "@/components/general/Hero.astro";
import About from "@/components/home/About.astro";
import Skills from "@/components/home/Skills.astro";
import { Button } from "@/components/ui/button";
import { t } from "@/i18n";
import type { Locale } from "@/i18n";
import { defaultLocale, isLocale } from "@/i18n";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

const lang = isLocale(Astro.params.lang as string)
  ? (Astro.params.lang as Locale)
  : defaultLocale;
---

<Layout
  title={t(lang, "home.title")}
  description={t(lang, "home.description")}
  lang={lang}
>
  <Hero
    title={t(lang, "hero.title")}
    subtitle={t(lang, "hero.subtitle")}
    bgImage="/home/hero.webp"
  >
    <a href={`/${lang}/development`}
      ><Button variant="secondary" size="lg" className="cursor-pointer"
        >{t(lang, "hero.cta.development")}</Button
      >
    </a>
    <a href={`/${lang}/design`}
      ><Button variant="secondary" size="lg" className="cursor-pointer"
        >{t(lang, "hero.cta.design")}</Button
      >
    </a>
  </Hero>
  <About lang={lang} />
  <Skills lang={lang} />
</Layout>
