---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import { MediaCarousel } from "@/components/portfolio/MediaCarousel";
import Prose from "@/components/general/Prose.astro";
import type { DevProject } from "@/models/collections.model";
import type { Locale } from "@/i18n";

export async function getStaticPaths() {
  const allDevProjects: DevProject[] = await getCollection("dev-projects");

  return ["es", "en"].flatMap((lang) =>
    allDevProjects
      .filter((project) => project.data.lang === lang)
      .map((project) => ({
        params: { lang, slug: project.id },
        props: { project },
      })),
  );
}

const { project } = Astro.props as { project: DevProject };
const lang = project.data.lang as Locale;

const { Content } = await render(project);
---

<ProjectLayout project={project}>
  <Prose>
    <Content />
  </Prose>
  {
    project.data.media && (
      <MediaCarousel media={project.data.media} lang={lang} client:load />
    )
  }
</ProjectLayout>
