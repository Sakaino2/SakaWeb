---
import Layout from "../../../layouts/Layout.astro";
import { ContactForm } from "../../../components/contact/ContactForm.tsx";
import Container from "../../../components/general/Container.astro";
import { FaLinkedin, FaBehanceSquare } from "react-icons/fa";
import { defaultLocale, isLocale, t } from "@/i18n";
import type { Locale } from "@/i18n";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

const lang = isLocale(Astro.params.lang as string)
  ? (Astro.params.lang as Locale)
  : defaultLocale;
---

<Layout
  title={t(lang, "contact.metaTitle")}
  description={t(lang, "contact.metaDescription")}
  lang={lang}
>
  <Container className="py-16">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="flex flex-col gap-6">
        <h1 class="text-4xl font-bold tracking-tight">{t(lang, "contact.title")}</h1>
        <p class="text-lg text-muted-foreground text-justify">
          {t(lang, "contact.message")}
        </p>
        <div class="flex gap-4 mt-4">
          <a
            href="https://www.linkedin.com/in/jorgesakaino/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="hover:text-primary transition-colors"
          >
            <span class="sr-only">LinkedIn</span>
            <FaLinkedin size={32} />
          </a>
          <a
            href="https://www.behance.net/sakainojorge"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Behance"
            class="hover:text-primary transition-colors"
          >
            <span class="sr-only">Behance</span>
            <FaBehanceSquare size={32} />
          </a>
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-semibold mb-4">{t(lang, "contact.formTitle")}</h2>
        <ContactForm lang={lang} client:load />
      </div>
    </div>
  </Container>
</Layout>
