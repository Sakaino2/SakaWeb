---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import DesignProjectCard from "../../../components/portfolio/DesignProjectCard.astro";
import Container from "@/components/general/Container.astro";
import SectionTitle from "@/components/general/SectionTitle.astro";
import type { DesignProject } from "@/models/collections.model";
import { filterDesignProjects } from "@/utils/utils";
import { defaultLocale, isLocale, t } from "@/i18n";
import type { Locale } from "@/i18n";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

const lang = isLocale(Astro.params.lang as string)
  ? (Astro.params.lang as Locale)
  : defaultLocale;

const allDesignProjects: DesignProject[] =
  await getCollection("design-projects");
const filteredDesignProjects = filterDesignProjects(allDesignProjects, lang);
filteredDesignProjects.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title={t(lang, "design.metaTitle")} description={t(lang, "design.metaDescription")} lang={lang}>
  <Container className="py-16">
    <SectionTitle>{t(lang, "design.sectionTitle")}</SectionTitle>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {
        filteredDesignProjects.map((project) => (
          <DesignProjectCard project={project} lang={lang} />
        ))
      }
    </div>
  </Container>
</Layout>
