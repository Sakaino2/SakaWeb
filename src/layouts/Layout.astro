---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/general/Footer.astro";
import Header from "@/components/general/Header.astro";
import ThemeScript from "@/components/general/ThemeScript.astro";
import LangScript from "@/components/general/LangScript.astro";
import { Font } from "astro:assets";
import { defaultLocale, normalizeLocale, ogLocaleFor, t, type UIKey } from "@/i18n";
import type { Locale } from "@/i18n";

const SITE_TITLE = "Sakaweb";
const SITE_IMAGE = "/home/hero.webp";

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description,
  image = SITE_IMAGE,
  lang,
} = Astro.props;

const locale: Locale = normalizeLocale(lang ?? Astro.currentLocale);
const t_ = (key: UIKey) => t(locale, key);

const siteDescription = description ?? t_("seo.siteDescription");

const pathname = Astro.url.pathname;
const alternateCodes = ["es", "en"].filter((c) => c !== locale);

function localeHref(code: string, currentPath: string): string {
  const rest = currentPath.replace(/^\/(es|en)(\/|$)/, "");
  return `/${code}${rest.startsWith("/") ? rest : "/" + rest}`;
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logos/logo-icon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={siteDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={ogLocaleFor(locale)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={image} />

    <link rel="canonical" href={Astro.url} />
    {
      alternateCodes.map((code) => (
        <link rel="alternate" hreflang={code} href={localeHref(code, pathname)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={localeHref(defaultLocale, pathname)} />

    <ThemeScript />
    <LangScript />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Jorge Sakaino",
      "url": Astro.url.origin,
      "jobTitle": t_("seo.jobTitle"),
      "sameAs": [
        "https://www.linkedin.com/in/jorgesakaino/",
        "https://www.behance.net/sakainojorge"
      ]
    })} />

    <Font cssVariable="--font-outfit" preload />
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary focus:text-[#0e6a6c] focus:px-4 focus:py-2 focus:rounded-md"
    >
      {t_("skipToContent")}
    </a>
    <Header lang={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={locale} />
  </body>
</html>
